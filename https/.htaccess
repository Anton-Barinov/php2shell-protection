# Reject multipart/form-data POST requests before PHP execution.
# WARNING: This also blocks legitimate multipart forms and uploads.
RewriteEngine On
RewriteCond %{REQUEST_METHOD} ^POST$ [NC]
RewriteCond %{HTTP:Content-Type} ^[[:space:]]*multipart/form-data([;,[:space:]]|$) [NC]
RewriteRule ^ - [F,L]
